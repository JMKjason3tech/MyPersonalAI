<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Milestone 1 deliberately requests ZERO permissions.
        Future milestones (voice, tools, network research, etc.) will
        each add the specific permission they need, one at a time,
        and will be called out for approval per the confirmation policy
        in the project instructions.
    -->

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.MyPersonalAI"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MyPersonalAI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
